# Lista blanca: el repo solo contiene lo necesario para servir la página.
# Todo lo que no esté habilitado abajo queda fuera.
/*

!/.gitignore
!/index.html
!/styles.css
!/script.js
!/favicon.ico
!/uploads/

# Dentro de uploads/, archivos que la página no carga
/uploads/web/manifest.json
/uploads/web/**/*-1920.jpg
/uploads/icons/icon-512.png

# Basura del sistema operativo en cualquier carpeta
.DS_Store
Thumbs.db
desktop.ini
